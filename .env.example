# Aurora Studio - root environment example
# Copy to .env before deploying or running docker compose

# Django
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-ec2-public-ip,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://your-ec2-public-ip:8080,https://your-domain.com
USE_POSTGRES=0

# Notification routing
NOTIFICATION_SENDER=mock
NOTIFICATIONS_SERVICE_URL=http://flask:5001/api/v2/funcionalidad
NOTIFICATIONS_ASYNC=1

# Celery / Redis
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Public proxy port exposed by nginx in docker compose
NGINX_HOST_PORT=8080

# Optional database override for future PostgreSQL deployment
POSTGRES_DB=aurora_db
POSTGRES_USER=aurora_user
POSTGRES_PASSWORD=aurora_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
